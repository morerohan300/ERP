        "role": ["view", "create", "edit", "delete"],
        "settings": ["view", "edit"],
        "currency": ["view", "create", "edit", "delete"],
        "tax": ["view", "create", "edit", "delete"],
        "fiscal_year": ["view", "create", "edit", "delete"],
        "numbering": ["view", "edit"],
        "module": ["view", "edit"],
        "custom_field": ["view", "create", "edit", "delete"],
        "approval_workflow": ["view", "create", "edit", "delete"],
        "approval": ["view", "approve"],
        "audit_log": ["view", "export"],
        "backup": ["view", "create", "delete"]
    },
    "menu": [
        {
            "label": "Dashboard",
            "route": "dashboard",
            "icon": "home",
            "section": "main"
        },
        {
