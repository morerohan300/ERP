                { "label": "Branches", "route": "branches.index", "permission": "core.branch.view" },
                { "label": "Departments", "route": "departments.index", "permission": "core.department.view" }
            ]
        },
        {
            "label": "Users & Access",
            "icon": "users",
            "section": "admin",
            "children": [
                { "label": "Users", "route": "users.index", "permission": "core.user.view" },
                { "label": "Roles & Permissions", "route": "roles.index", "permission": "core.role.view" },
                { "label": "Login History", "route": "login-history.index", "permission": "core.audit_log.view" }
            ]
        },
        {
            "label": "Settings",
            "icon": "cog",
            "section": "admin",
            "children": [
                { "label": "General", "route": "settings.general", "permission": "core.settings.view" },
                { "label": "Currencies", "route": "currencies.index", "permission": "core.currency.view" },
                { "label": "Taxes", "route": "taxes.index", "permission": "core.tax.view" },
                { "label": "Fiscal Years", "route": "fiscal-years.index", "permission": "core.fiscal_year.view" },
                { "label": "Document Numbering", "route": "numbering.index", "permission": "core.numbering.view" },
                { "label": "Modules", "route": "modules.index", "permission": "core.module.view" },
                { "label": "Custom Fields", "route": "custom-fields.index", "permission": "core.custom_field.view" },
                { "label": "Approval Workflows", "route": "approval-workflows.index", "permission": "core.approval_workflow.view" },
                { "label": "Email & SMS", "route": "settings.communication", "permission": "core.settings.view" },
                { "label": "Payment Gateways", "route": "settings.payments", "permission": "core.settings.view" }
            ]
        },
        {
            "label": "System",
            "icon": "server",
            "section": "admin",
            "children": [
                { "label": "Audit Log", "route": "audit-log.index", "permission": "core.audit_log.view" },
                { "label": "Import / Export", "route": "data-transfers.index", "permission": "core.user.import" },
